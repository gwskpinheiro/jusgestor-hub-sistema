# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NÃO deve ser versionado (RNF02).
#
# Gere valores aleatórios, por exemplo (PowerShell + Docker):
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=
# 1 apenas no desenvolvimento local. Sem esta variável, o padrão é 0 (produção).
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens completas (com https://), separadas por vírgula. Vazio no desenvolvimento.
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 em produção (Render): cookies seguros, redirecionamento para HTTPS e HSTS.
DJANGO_HTTPS=0

# Banco usado pela aplicação: local (PostgreSQL do Docker) ou supabase.
# Os testes automatizados sempre exigem "local".
DB_ALVO=local

# PostgreSQL local (Docker) — desenvolvimento e testes
POSTGRES_DB=jusgestor
POSTGRES_USER=jusgestor
POSTGRES_PASSWORD=

# Supabase — Session Pooler (Dashboard > Connect > Session pooler)
# Usado apenas quando DB_ALVO=supabase. Veja docs/supabase.md.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# require (padrão): conexão criptografada.
# verify-full: também verifica o certificado; exige SUPABASE_DB_SSLROOTCERT.
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_SSLROOTCERT=
